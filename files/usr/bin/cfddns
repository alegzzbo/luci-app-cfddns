#!/bin/sh
# cfddns - Cloudflare DDNS for multi-WAN OpenWrt
# Usage: cfddns run [network] [retry] | zones | records | add | delete | tgtest

. /lib/functions.sh
. /lib/functions/network.sh

exec 2>&1

CF_API="https://api.cloudflare.com/client/v4"
LOCK=/var/lock/cfddns.lock
STATE=/var/run/cfddns
DEFAULT_SOURCES="https://ifconfig.me/ip https://api.ipify.org https://icanhazip.com https://checkip.amazonaws.com"
WEB_SOURCES=""
LAST=1
FAILED=0

log() { echo "$*" >&2; logger -t cfddns "$*"; }

is_ipv4() {
    echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
    local o IFS=.
    for o in $1; do [ "$o" -le 255 ] || return 1; done
    return 0
}

is_private() {
    case "$1" in
        0.*|10.*|127.*|169.254.*|192.168.*) return 0 ;;
        172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 0 ;;
        100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 0 ;;
    esac
    return 1
}

valid_domain() { echo "$1" | grep -qE '^[A-Za-z0-9_.-]+\.[A-Za-z0-9-]{2,}$'; }

lock() {
    local i=0 pid
    while ! mkdir "$LOCK" 2>/dev/null; do
        pid=$(cat "$LOCK/pid" 2>/dev/null)
        if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
            rm -rf "$LOCK"; continue
        fi
        i=$((i + 1))
        if [ "$i" -ge 60 ]; then rm -rf "$LOCK"; continue; fi
        sleep 1
    done
    echo $$ > "$LOCK/pid"
    trap 'rm -rf "$LOCK"' EXIT INT TERM
}
unlock() { rm -rf "$LOCK"; }

# wait (max 2 min) until the clock looks sane, TLS needs correct time
wait_time() {
    local i=0
    while [ "$(date +%s)" -lt 1735689600 ] && [ "$i" -lt 120 ]; do
        i=$((i + 5)); sleep 5
    done
}

### Config
add_service() {
    echo "$1" | grep -qE '^https?://[^ "'"'"']+$' || { log "ignoring invalid ip_service '$1'"; return 0; }
    WEB_SOURCES="$WEB_SOURCES $1"
}

load_cfg() {
    config_load cfddns
    config_get_bool G_EN global enabled 0
    config_get TOKEN global api_token
    config_get_bool TG_EN telegram enabled 0
    config_get TG_TOKEN telegram bot_token
    config_get TG_CHAT telegram chat_id
    config_get PX_LEGACY telegram proxy
    config_get PX_TYPE telegram proxy_type none
    config_get PX_HOST telegram proxy_host
    config_get PX_PORT telegram proxy_port
    config_get PX_USER telegram proxy_user
    config_get PX_PASS telegram proxy_pass
    config_get_bool PX_INSECURE telegram proxy_insecure 0
    case "$PX_TYPE" in http|https|socks5h) ;; *) PX_TYPE=none ;; esac
    config_get_bool TG_UPD telegram notify_update 1
    config_get_bool TG_ERR telegram notify_error 0
    config_get REPEAT_H telegram error_repeat 0
    case "$REPEAT_H" in ''|*[!0-9]*) REPEAT_H=0 ;; esac
    config_get RETRIES global retries 3
    config_get RETRY_DELAY global retry_delay 20
    case "$RETRIES" in ''|*[!0-9]*) RETRIES=3 ;; esac
    case "$RETRY_DELAY" in ''|*[!0-9]*) RETRY_DELAY=20 ;; esac
    [ "$RETRIES" -ge 1 ] || RETRIES=1
    [ "$RETRIES" -le 10 ] || RETRIES=10
    [ "$RETRY_DELAY" -le 300 ] || RETRY_DELAY=300
    WEB_SOURCES=""
    config_list_foreach global ip_service add_service
    [ -n "$WEB_SOURCES" ] || WEB_SOURCES="$DEFAULT_SOURCES"
}

### Telegram
tg() {
    [ "$TG_EN" = 1 ] && [ -n "$TG_TOKEN" ] && [ -n "$TG_CHAT" ] || return 1
    local text="$1" resp port
    set -- -s --max-time 15
    if [ "$PX_TYPE" != "none" ] && [ -n "$PX_HOST" ]; then
        case "$PX_TYPE" in
            https) port=443 ;;
            socks5h) port=1080 ;;
            *) port=3128 ;;
        esac
        set -- "$@" -x "$PX_TYPE://$PX_HOST:${PX_PORT:-$port}"
        [ -n "$PX_USER" ] && set -- "$@" -U "$PX_USER:$PX_PASS"
        if [ "$PX_TYPE" = "https" ]; then
            [ "$PX_INSECURE" = 1 ] && set -- "$@" --proxy-insecure
            curl -V 2>/dev/null | grep -q 'HTTPS-proxy' || log "Telegram: this curl build has no HTTPS-proxy support"
        fi
    elif [ -n "$PX_LEGACY" ]; then
        set -- "$@" -x "$PX_LEGACY"
    fi
    resp=$(curl "$@" -G "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" \
        --data-urlencode "chat_id=$TG_CHAT" --data-urlencode "text=$text")
    [ "$(jsonfilter -s "$resp" -e '@.ok')" = "true" ] && return 0
    log "Telegram: send failed ${resp:+($resp)}"
    return 1
}
notify_ok() { [ "$TG_UPD" = 1 ] && tg "$1"; return 0; }
# Error notifications are de-duplicated: the same text for the same key is sent once
# (again after REPEAT_H hours if > 0); a "recovered" message is sent when it is fixed.
notify_err() { # key text
    [ "$LAST" = 1 ] && [ "$TG_ERR" = 1 ] || return 0
    local f old ts now
    f="$STATE/err_$(printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_')"
    now=$(date +%s)
    if [ -f "$f" ]; then
        old=$(sed -n 1p "$f"); ts=$(sed -n 2p "$f")
        if [ "$old" = "$2" ]; then
            [ "$REPEAT_H" -gt 0 ] && [ $((now - ${ts:-0})) -ge $((REPEAT_H * 3600)) ] || return 0
        fi
    fi
    mkdir -p "$STATE"
    tg "$2" && printf '%s\n%s\n' "$2" "$now" > "$f"
    return 0
}

notify_clear() { # key text; returns 0 if an error had been reported before
    local f
    f="$STATE/err_$(printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_')"
    [ -f "$f" ] || return 1
    rm -f "$f"
    [ "$TG_ERR" = 1 ] && tg "$2"
    return 0
}

### Cloudflare
cf() { # method path [json]
    if [ -n "$3" ]; then
        curl -s --max-time 15 -X "$1" "$CF_API$2" \
            -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" --data "$3"
    else
        curl -s --max-time 15 -X "$1" "$CF_API$2" \
            -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json"
    fi
}
cf_ok() { [ "$(jsonfilter -s "$1" -e '@.success')" = "true" ]; }
cf_err() {
    [ -n "$1" ] || { echo "no response (timeout/network)"; return; }
    local m
    m=$(jsonfilter -s "$1" -e '@.errors[0].message')
    echo "${m:-invalid response}"
}

get_zone_id() { # domain; walks up labels: a.b.example.com -> b.example.com -> example.com
    local d="$1" resp id
    while [ "${d#*.}" != "$d" ]; do
        resp=$(cf GET "/zones?name=$d")
        if ! cf_ok "$resp"; then
            log "Zone lookup failed: $(cf_err "$resp")"
            return 1
        fi
        id=$(jsonfilter -s "$resp" -e '@.result[0].id')
        if [ -n "$id" ]; then echo "$id"; return 0; fi
        d="${d#*.}"
    done
    return 1
}

### IP detection
curl_rc_text() {
    case "$1" in
        6) echo "DNS lookup failed" ;;
        7) echo "connection failed" ;;
        28) echo "timeout" ;;
        35|51|58|59|60|77|83) echo "TLS/certificate error (check system time)" ;;
        *) echo "curl error $1" ;;
    esac
}

# sets GOT_IP on success, IP_ERR (human readable reason) on failure
get_ip() { # network source
    local net="$1" src="$2" ip dev url raw rc host why=""
    GOT_IP=""
    IP_ERR=""
    if [ "$src" = "iface" ]; then
        network_get_ipaddr ip "$net"
        if [ -z "$ip" ]; then
            IP_ERR="interface has no IPv4 address (not connected yet?)"
            return 1
        fi
        if is_private "$ip"; then
            IP_ERR="interface IP $ip is private (NAT/CGNAT), not a public address. Set IP source to 'web' or ask the ISP for a public IP"
            return 1
        fi
    else
        network_get_device dev "$net"
        if [ -z "$dev" ]; then
            IP_ERR="interface is down (no device)"
            return 1
        fi
        for url in $WEB_SOURCES; do
            host="${url#*://}"; host="${host%%/*}"
            raw=$(curl -4 -s --max-time 8 --interface "$dev" "$url" 2>/dev/null); rc=$?
            if [ "$rc" != 0 ]; then
                why="$why; $host: $(curl_rc_text "$rc")"
                continue
            fi
            ip=$(echo "$raw" | head -c 2048 | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n1)
            if [ -z "$ip" ] || ! is_ipv4 "$ip"; then
                why="$why; $host: no IPv4 in response"; ip=""; continue
            fi
            if is_private "$ip"; then
                why="$why; $host: returned private IP $ip"; ip=""; continue
            fi
            break
        done
        if [ -z "$ip" ]; then
            [ -n "$why" ] && why=" (${why#; })"
            IP_ERR="no public IPv4 from web services via $dev$why"
            return 1
        fi
    fi
    GOT_IP="$ip"
    return 0
}

### Update one domain
update_domain() { # section domain zone ip
    local sec="$1" dom="$2" zone="$3" ip="$4" resp rid cur body
    if [ -z "$zone" ]; then
        zone=$(get_zone_id "$dom")
        if [ -z "$zone" ]; then
            log "[$dom] zone not found (token needs Zone:Read + DNS:Edit)"
            notify_err "dom_$dom" "cfddns: $dom - zone not found"
            return 1
        fi
        uci -q set "cfddns.$sec.zone_id=$zone" && uci -q commit cfddns
        log "[$dom] zone id cached: $zone"
    fi

    resp=$(cf GET "/zones/$zone/dns_records?type=A&name=$dom")
    if ! cf_ok "$resp"; then
        log "[$dom] API error: $(cf_err "$resp")"
        notify_err "dom_$dom" "cfddns: $dom - API error: $(cf_err "$resp")"
        return 1
    fi
    rid=$(jsonfilter -s "$resp" -e '@.result[0].id')
    cur=$(jsonfilter -s "$resp" -e '@.result[0].content')

    if [ -z "$rid" ]; then
        body="{\"type\":\"A\",\"name\":\"$dom\",\"content\":\"$ip\",\"ttl\":1,\"proxied\":false}"
        resp=$(cf POST "/zones/$zone/dns_records" "$body")
    elif [ "$cur" = "$ip" ]; then
        log "[$dom] up to date ($ip)"
        notify_clear "dom_$dom" "cfddns: $dom recovered, record is up to date ($ip)"
        return 0
    else
        resp=$(cf PATCH "/zones/$zone/dns_records/$rid" "{\"content\":\"$ip\"}")
    fi

    if cf_ok "$resp"; then
        log "[$dom] updated: ${cur:-none} -> $ip"
        notify_clear "dom_$dom" "cfddns: $dom recovered, updated -> $ip" || notify_ok "cfddns: $dom -> $ip"
    else
        log "[$dom] update failed: $(cf_err "$resp")"
        notify_err "dom_$dom" "cfddns: $dom - update failed: $(cf_err "$resp")"
        return 1
    fi
}

handle_domain() {
    local s="$1" en iface name zone
    config_get_bool en "$s" enabled 1
    [ "$en" = 1 ] || return 0
    config_get iface "$s" interface
    [ "$iface" = "$CUR_NET" ] || return 0
    config_get name "$s" name
    config_get zone "$s" zone_id
    valid_domain "$name" || { log "[$s] invalid domain '$name'"; return 0; }
    if [ -z "$CUR_IP" ]; then
        [ "$IP_FAIL" = 1 ] && return 0
        if get_ip "$CUR_NET" "$CUR_SRC"; then
            CUR_IP="$GOT_IP"
            log "[$CUR_NET] IP: $CUR_IP"
            notify_clear "ip_$CUR_NET" "cfddns: [$CUR_NET] recovered, IP $CUR_IP"
        else
            IP_FAIL=1
            FAILED=1
            log "[$CUR_NET] $IP_ERR"
            notify_err "ip_$CUR_NET" "cfddns: [$CUR_NET] $IP_ERR"
            return 0
        fi
    fi
    update_domain "$s" "$name" "$zone" "$CUR_IP" || FAILED=1
}

handle_iface() {
    local s="$1" en net
    config_get_bool en "$s" enabled 1
    [ "$en" = 1 ] || return 0
    config_get net "$s" network
    [ -n "$net" ] || return 0
    [ -z "$ONLY" ] || [ "$ONLY" = "$net" ] || return 0
    CUR_NET="$net"
    config_get CUR_SRC "$s" ip_source web
    CUR_IP=""
    IP_FAIL=0
    config_foreach handle_domain domain
}

zone_cb() {
    local s="$1" name zone
    config_get name "$s" name
    valid_domain "$name" || { log "[$s] invalid domain '$name'"; return 0; }
    zone=$(get_zone_id "$name")
    if [ -n "$zone" ]; then
        uci -q set "cfddns.$s.zone_id=$zone"
        ZCHG=1
        log "$name -> $zone"
    else
        log "$name: zone not found"
    fi
}

cmd_run() {
    ONLY="$1"
    local retry="$2" n=0
    load_cfg
    [ "$G_EN" = 1 ] || { log "disabled in config"; exit 0; }
    [ -n "$TOKEN" ] || { log "API token not set"; exit 1; }
    [ "$retry" = "retry" ] && wait_time
    while :; do
        n=$((n + 1))
        if [ "$retry" = "retry" ] && [ "$n" -lt "$RETRIES" ]; then LAST=0; else LAST=1; fi
        FAILED=0
        lock
        config_foreach handle_iface interface
        unlock
        [ "$FAILED" = 0 ] && break
        [ "$LAST" = 1 ] && break
        log "attempt $n/$RETRIES failed, retry in ${RETRY_DELAY}s"
        sleep "$RETRY_DELAY"
    done
    [ "$FAILED" = 0 ]
}

# prints one JSON line per zone: {"zone_id":..,"zone":..,"records":<CF response>}
cmd_records() {
    exec 2>/dev/null
    load_cfg
    [ -n "$TOKEN" ] || { echo '{"error":"API token not set (Save & Apply first)"}'; exit 1; }
    local page=1 pages=1 resp rec i id name
    while [ "$page" -le "$pages" ]; do
        resp=$(cf GET "/zones?per_page=50&page=$page")
        if ! cf_ok "$resp"; then
            echo "{\"error\":\"$(cf_err "$resp" | tr -d '"\\')\"}"
            exit 1
        fi
        pages=$(jsonfilter -s "$resp" -e '@.result_info.total_pages')
        [ -n "$pages" ] || pages=1
        i=0
        while :; do
            id=$(jsonfilter -s "$resp" -e "@.result[$i].id")
            [ -n "$id" ] || break
            name=$(jsonfilter -s "$resp" -e "@.result[$i].name")
            rec=$(cf GET "/zones/$id/dns_records?type=A&per_page=500" | tr -d '\r\n')
            cf_ok "$rec" && echo "{\"zone_id\":\"$id\",\"zone\":\"$name\",\"records\":$rec}"
            i=$((i + 1))
        done
        page=$((page + 1))
    done
    return 0
}

cmd_zones() {
    load_cfg
    [ -n "$TOKEN" ] || { log "API token not set (Save & Apply first)"; exit 1; }
    config_foreach zone_cb domain
    [ "$ZCHG" = 1 ] && uci -q commit cfddns
    return 0
}

cmd_tgtest() {
    load_cfg
    TG_EN=1
    if tg "cfddns: test message"; then log "Telegram: OK"; else log "Telegram: FAILED (check token/chat id/proxy; Save & Apply first)"; fi
}

is_hex32() { echo "$1" | grep -qE '^[0-9a-f]{32}$'; }

cmd_add() { # zone_id name ipv4 [ttl] [proxied]
    local zone="$1" name="$2" ip="$3" ttl="${4:-1}" prox="${5:-false}" resp body
    load_cfg
    [ -n "$TOKEN" ] || { log "API token not set"; exit 1; }
    is_hex32 "$zone" || { log "invalid zone id"; exit 1; }
    valid_domain "$name" || { log "invalid domain '$name'"; exit 1; }
    is_ipv4 "$ip" || { log "invalid IPv4 address '$ip'"; exit 1; }
    case "$ttl" in
        1) ;;
        ''|*[!0-9]*) log "invalid TTL '$ttl'"; exit 1 ;;
        *) if [ "$ttl" -lt 60 ] || [ "$ttl" -gt 86400 ]; then log "TTL must be 1 (auto) or 60..86400"; exit 1; fi ;;
    esac
    [ "$prox" = "true" ] || prox=false
    [ "$prox" = "true" ] && ttl=1
    body="{\"type\":\"A\",\"name\":\"$name\",\"content\":\"$ip\",\"ttl\":$ttl,\"proxied\":$prox}"
    resp=$(cf POST "/zones/$zone/dns_records" "$body")
    if cf_ok "$resp"; then
        log "Created A record $name -> $ip (ttl $ttl, proxied $prox)"
    else
        log "Create failed: $(cf_err "$resp")"
        exit 1
    fi
}

cmd_delete() { # zone_id record_id
    local zone="$1" rid="$2" resp rtype rname
    load_cfg
    [ -n "$TOKEN" ] || { log "API token not set"; exit 1; }
    is_hex32 "$zone" && is_hex32 "$rid" || { log "invalid zone/record id"; exit 1; }
    resp=$(cf GET "/zones/$zone/dns_records/$rid")
    cf_ok "$resp" || { log "Lookup failed: $(cf_err "$resp")"; exit 1; }
    rtype=$(jsonfilter -s "$resp" -e '@.result.type')
    rname=$(jsonfilter -s "$resp" -e '@.result.name')
    [ "$rtype" = "A" ] || { log "Refusing to delete $rname: type is '$rtype', not A"; exit 1; }
    resp=$(cf DELETE "/zones/$zone/dns_records/$rid")
    if cf_ok "$resp"; then
        log "Deleted A record $rname"
    else
        log "Delete failed: $(cf_err "$resp")"
        exit 1
    fi
}

case "$1" in
    run) cmd_run "$2" "$3" ;;
    zones) cmd_zones ;;
    records) cmd_records ;;
    add) shift; cmd_add "$@" ;;
    delete) shift; cmd_delete "$@" ;;
    tgtest) cmd_tgtest ;;
    *) echo "Usage: cfddns run [network] [retry] | zones | records | add <zone_id> <name> <ip> [ttl] [proxied] | delete <zone_id> <record_id> | tgtest"; exit 1 ;;
esac
