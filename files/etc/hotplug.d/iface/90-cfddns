#!/bin/sh
# ppp-like protocols: update on connect (ifup) only.
# dhcp/static/others: update on ifup and when the address changes (ifupdate).
[ "$(uci -q get cfddns.global.enabled)" = "1" ] || exit 0
uci -q show cfddns | grep -q "\.network='$INTERFACE'" || exit 0

proto=$(uci -q get network."$INTERFACE".proto)
case "$proto" in
    ppp|pppoe|pppoa|pptp|l2tp|3g) delay=3; on_update=0 ;;
    *) delay=5; on_update=1 ;;
esac

case "$ACTION" in
    ifup) ;;
    ifupdate) [ "$on_update" = "1" ] && [ "$IFUPDATE_ADDRESSES" = "1" ] || exit 0 ;;
    *) exit 0 ;;
esac

( sleep "$delay"; /usr/bin/cfddns run "$INTERFACE" retry >/dev/null 2>&1 ) &
